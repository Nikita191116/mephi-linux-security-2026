    1  whoami
    2  sudo whoami
    3  whoami
    4  sudo groupadd students
    5  getent group students
    6  sudo useradd -m -u 1234 -g students -s /bin/bash user1
    7  sudo passwd user1
    8  sudo chage -M 90 user1
    9  id user1
   10  sudo chage -l user1
   11  stat /home/user1
   12  sudo find / -type f -perm -4000 2>/dev/null
   13  sudo find / -type f -perm -4000 2>/dev/null > ~/setuid-files.out
   14  cat ~/setuid-files.out
   15  wc -l ~/setuid-files.out
   16  ps -eo pid,ruid,euid,comm | awk 'NR==1 || ($2>=1000 && $2<65534 && $3==0)'
   17  ps -eo pid,ruid,euid,comm | awk 'NR==1 || ($2>=1000 && $2<65534 && $3==0)' > ~/privileged-processes.out
   18  cat ~/privileged-processes.out
   19  echo "MEPHI SUID TEST SUCCESS" | sudo tee /root/mephi-suid-test.txt
   20  sudo chmod 600 /root/mephi-suid-test.txt
   21  sudo ls -l /root/mephi-suid-test.txt
   22  sudo -u user1 cat /root/mephi-suid-test.txt
   23  sudo cp /usr/bin/cat /home/user1/cat-suid
   24  sudo chown root:root /home/user1/cat-suid
   25  sudo chmod 4755 /home/user1/cat-suid
   26  stat /home/user1/cat-suid
   27  sudo stat /home/user1/cat-suid
   28  sudo -u user1 /home/user1/cat-suid /root/mephi-suid-test.txt
   29  sudo stat /home/user1 /home/user1/cat-suid > ~/stat.out
   30  sudo -u user1 /home/user1/cat-suid /root/mephi-suid-test.txt > ~/setuid-test.out
   31  which chown
   32  which setcap
   33  which getcap
   34  sudo -u user1 touch /home/user1/chown-test.txt
   35  sudo stat -c '%U:%G %n' /home/user1/chown-test.txt
   36  sudo cp /usr/bin/chown /home/user1/chown-cap
   37  sudo chown root:root /home/user1/chown-cap
   38  sudo chmod 755 /home/user1/chown-cap
   39  sudo -u user1 /home/user1/chown-cap student /home/user1/chown-test.txt
   40  sudo setcap cap_chown=ep /home/user1/chown-cap
   41  sudo getcap /home/user1/chown-cap
   42  sudo -u user1 /home/user1/chown-cap student /home/user1/chown-test.txt
   43  sudo stat -c '%U:%G %n' /home/user1/chown-test.txt
   44  sudo stat /home/user1/chown-cap >> ~/stat.out
   45  sudo getcap /home/user1/chown-cap > ~/getcap.out
   46  sudo getcap /home/user1/chown-cap
   47  sudo stat -c '%U:%G %n' /home/user1/chown-test.txt
   48  which date
   49  printf 'user1 ALL=(root) /usr/bin/date -s *\n' | sudo tee /etc/sudoers.d/user1-time
   50  sudo chmod 440 /etc/sudoers.d/user1-time
   51  sudo visudo -cf /etc/sudoers
   52  sudo -l -U user1
   53  su - user1
   54  history > ~/history.out
    1  sudo date -s "$(date '+%Y-%m-%d %H:%M:%S')"
